 với ân sủng của ngươi. Hồi «Cha muốn ngươi hạ một nhà đối đầu» đến sớm.","T9/5 hạ tuầnTin trong cung · Hạ Hà, người hầu của ngươi · «Bí mật của chủ nhân» chương 9: «Giữ hay nói» — Bí mật còn trong tay nàng. Dư Tiểu Hoàn nay không còn ở đây, kẻ đứng đối mặt nàng là Doãn Hạnh Nhi.","T9/5 hạ tuầnTin trong cung · Hoa Viên Thải Hà · «Chủ cũ» chương 4: «Chủ cũ» — Chủ cũ thành tri kỷ."],"sucTrace":[70,68,84,71,73],"acts":{"card":531,"dilemma":793,"talk":311,"selfStudy":175,"pick":206,"accuse":11,"virStudy":31,"exam":6,"go":59,"charity":1}}],"info":[{"o":"tt","inPal":true,"r":2,"end":null,"dead":false,"mo":23,"sac":86,"tai":100,"danh":48,"bac":73,"arts":3,"intel":11,"stuck":false}]}